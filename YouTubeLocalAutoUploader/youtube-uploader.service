[Unit]
Description=YouTube Local Auto Uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samir
Group=samir
WorkingDirectory=/home/samir/Documents/YouTubeLocalAutoUploader
Environment="HOME=/home/samir"
Environment="USER=samir"
Environment="LOGNAME=samir"
Environment="HOST=0.0.0.0"
Environment="PORT=8080"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/samir/Documents/YouTubeLocalAutoUploader/.venv/bin/python /home/samir/Documents/YouTubeLocalAutoUploader/run.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
